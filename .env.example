# Instagram API Configuration
# See DEVELOPER_INSTRUCTIONS.md for setup guide
# Required: Access token from Facebook Developer Console
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here

# Optional but recommended for Business/Creator accounts:
# Your Instagram Business Account ID (get from Graph API Explorer)
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id

# Server Configuration
PORT=3000

# Optional: If you want to deploy to production, set NODE_ENV
# NODE_ENV=production
